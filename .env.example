# Gmail SMTP — used only by scripts/send-blog-update.js to broadcast a new note
# to people who asked for one. Never exposed to the browser.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Optional. Only read by scripts/send-blog-update.js to pull an existing Resend
# audience list. The site itself does not subscribe anyone.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
